# Public origin of the live site, used for canonical URLs, the sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.cocoscandyco.com

# Email (Resend). The quote form emails each request to INQUIRY_NOTIFY_EMAIL, or to the business email
# in src/lib/site.ts when that is blank.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. quotes@cocoscandyco.com. Without it Resend's shared test
# sender is used, which only delivers to the Resend account owner's own address.
EMAIL_FROM_ADDRESS=
INQUIRY_NOTIFY_EMAIL=
